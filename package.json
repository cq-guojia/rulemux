{
  "name": "rulemux",
  "version": "0.1.3",
  "description": "One set of rules, delivered to every AI coding agent: copies the rule files you declare into each agent's native workspace rules directory, with the same effect and token cost as writing AGENTS.md by hand.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cq-guojia/rulemux.git"
  },
  "homepage": "https://github.com/cq-guojia/rulemux#readme",
  "bugs": {
    "url": "https://github.com/cq-guojia/rulemux/issues"
  },
  "bin": {
    "rulemux": "bin/rulemux.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build:dist": "bash scripts/build-dist.sh",
    "prepublishOnly": "npm run build:dist"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "rulemux",
    "rules",
    "agents",
    "agents-md",
    "ai-coding-agent",
    "codebuddy",
    "workbuddy",
    "claude-code",
    "trae",
    "codex",
    "opencode",
    "prompt-caching"
  ]
}
