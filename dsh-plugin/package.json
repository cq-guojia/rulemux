{
  "name": "rulemux-dsh",
  "version": "0.3.1",
  "description": "rulemux rules inside DeepSeek Harness (dsh): reads the rule files rulemux syncs into <workspace>/.dsh/rules and injects them into the session.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "rulemux",
    "rules",
    "agents-md"
  ],
  "author": "cq-guojia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cq-guojia/rulemux.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/cq-guojia/rulemux"
}
